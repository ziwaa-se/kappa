{
  "permissions": {
    "allow": [
      "Bash(scripts/pv_lean.sh *)",
      "Bash(python3 scripts/pv_status.py *)",
      "Bash(python3 scripts/pv_snapshot.py *)",
      "Bash(python3 scripts/pv_usage.py *)",
      "Bash(python3 scripts/pv_audit_mech.py *)",
      "Bash(python3 scripts/pv_drive_status.py *)",
      "Bash(python3 scripts/pv_settings.py *)",
      "Bash(python3 scripts/pv_graph.py *)",
      "Bash(python3 scripts/pv_summary.py *)",
      "Bash(python3 scripts/pv_export.py *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Edit(pv_work/**)",
      "Write(pv_work/**)",
      "Edit(verification/**)",
      "Write(verification/**)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git clone *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python3 -m pip *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(elan *)",
      "Bash(lake update *)",
      "Bash(lake exe *)",
      "Bash(lake build *)",
      "Edit(.lake/**)",
      "Write(.lake/**)",
      "Edit(source/**)",
      "Write(source/**)",
      "Edit(verification/rules/**)",
      "Write(verification/rules/**)",
      "Edit(verification/source_baseline/**)",
      "Write(verification/source_baseline/**)",
      "Edit(pv_work/PVTools.lean)",
      "Write(pv_work/PVTools.lean)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/pv_guard.py\""
          }
        ]
      }
    ]
  }
}
